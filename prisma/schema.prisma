// Himal Commerce — multi-tenant commerce platform (Medusa-style)
// One platform, many stores. Each store has isolated products/orders/customers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== Tenant ======
model Store {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  tagline      String?
  logoUrl      String?
  bannerUrl    String?
  // Branding
  primaryColor String   @default("#9C1A1A") // Nepal crimson default
  accentColor  String   @default("#E8B547") // Saffron default
  currency     String   @default("NPR")
  // Owner / contact
  ownerName    String
  ownerEmail   String?
  ownerPhone   String?
  // Storefront contact info (shown in footer)
  supportPhone String?
  supportEmail String?
  address      String?
  // Social media
  socialTwitter   String?
  socialFacebook  String?
  socialInstagram String?
  socialTiktok    String?
  socialYoutube   String?
  // Status
  status       String   @default("active") // active | suspended | draft
  plan         String   @default("free") // free | pro | enterprise
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]
  categories   Category[]
  orders       Order[]
  customers    Customer[]
  members      StoreMember[]
}

// ====== Users (simplified — no password auth for demo) ======
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  memberships StoreMember[]
}

model StoreMember {
  id      String @id @default(cuid())
  userId  String
  storeId String
  role    String @default("owner") // owner | admin | staff
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

// ====== Catalog (scoped to Store) ======
model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String?
  subtitle    String?
  description String
  thumbnail   String?
  // Price stored in smallest currency unit (paisa for NPR) to avoid float issues
  price       Int
  compareAt   Int?
  sku         String?
  status      String   @default("published") // draft | published
  inventory   Int      @default(0)
  weightGrams Int?
  // Nepal-specific
  origin      String?
  isHandmade  Boolean  @default(false)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([storeId])
  @@unique([storeId, slug])
}

// Product variants — for size/color/weight options
// Each variant has its own SKU, price override (optional), and inventory
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  title     String  // e.g. "Red / Large" or "250g"
  price     Int?    // paisa — overrides Product.price when set
  inventory Int    @default(0)
  attributes Json   // e.g. { color: "Red", size: "L" } or { weight: "250g" }
  sortOrder Int    @default(0)
  orderItems OrderItem[]

  @@index([productId])
}

// Additional product images (beyond the thumbnail)
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int    @default(0)

  @@index([productId])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  icon        String?
  description String?
  imageUrl    String?
  parentId    String?  // self-relation for hierarchy
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int      @default(0)
  products    Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

// ====== Orders (scoped to Store) ======
model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber String
  status      String   @default("pending") // pending | processing | shipped | delivered | cancelled
  fulfillment String   @default("unfulfilled") // unfulfilled | fulfilled | returned
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // Customer snapshot (so order survives even if customer deleted)
  customerName     String
  customerPhone    String
  customerEmail    String?

  // Shipping — Nepal only
  shippingAddress  String
  shippingCity     String
  shippingDistrict String
  shippingZone     String // Province

  // Payment — Nepal methods
  paymentMethod String // cod | esewa | khalti
  paymentStatus String @default("unpaid") // unpaid | pending | paid | refunded

  // Money in paisa
  subtotal     Int
  shippingCost Int
  total        Int

  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     OrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  variantTitle String? // snapshot of variant title, e.g. "Red / Large"
  thumbnail String?
  price     Int
  quantity  Int
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  district  String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, phone])
  @@index([storeId])
}
