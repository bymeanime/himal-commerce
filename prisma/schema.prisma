// Himal Commerce — multi-tenant commerce platform (Medusa-style)
// One platform, many stores. Each store has isolated products/orders/customers.
//
// Schema v2 — incorporates expert-panel audit findings (security, finance,
// legal, ops, marketing, data, logistics). Adds: VAT/tax fields, PAN/VAT
// registration, audit log, analytics events, coupons, reviews, returns,
// couriers, plans/subscriptions, abandoned cart, order timestamps,
// invoice sequence, internal notes, structured address, age gate, and more.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== Tenant ======
model Store {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  tagline      String?
  logoUrl      String?
  bannerUrl    String?
  // Branding
  primaryColor String   @default("#9C1A1A") // Nepal crimson default
  accentColor  String   @default("#E8B547") // Saffron default
  currency     String   @default("NPR")
  // Owner / contact
  ownerName    String
  ownerEmail   String?
  ownerPhone   String?
  // Storefront contact info (shown in footer)
  supportPhone String?
  supportEmail String?
  address      String?
  // Social media
  socialTwitter   String?
  socialFacebook  String?
  socialInstagram String?
  socialTiktok    String?
  socialYoutube   String?
  socialViber     String?
  socialWhatsapp  String?

  // ====== Finance / Legal (Accountant + Legal panel) ======
  panNumber             String?  // Permanent Account Number (IRD Nepal)
  vatNumber             String?  // Separate from PAN — VAT-registered businesses
  vatRegistered         Boolean  @default(false)
  businessRegistrationNumber String?
  panDocumentUrl        String?
  businessRegistrationDocumentUrl String?
  // Tax configuration
  defaultTaxRate        Int      @default(1300) // basis points, 1300 = 13% Nepal VAT
  taxInclusiveDisplay   Boolean  @default(true) // prices shown include VAT
  vatInvoicePrefix      String   @default("INV")
  // Seller KYC / marketplace facilitator
  verificationStatus    String   @default("pending") // pending | under_review | verified | rejected | suspended
  agreedToSellerAgreementAt    DateTime?
  agreedToSellerAgreementVersion String?
  agreedToPrivacyPolicyAt      DateTime?
  // Return / refund / shipping policies (per-store override)
  refundPolicyDays      Int      @default(7)
  returnPolicyText      String?
  shippingPolicyText    String?

  // ====== Logistics (Logistics + CEO panels) ======
  codRiskThreshold      Int      @default(500000) // paisa — orders above this need COD verification
  freeShippingThreshold Int?     // paisa — orders above this ship free
  // Merchant-configurable shipping rates (JSON map of zone → { minWeight, maxWeight, rate })
  shippingRates         String?  // JSON string (sqlite doesn't support Json natively)

  // ====== Marketing (Marketing panel) ======
  announcementBar       String?  // JSON string { message, textColor, bgColor, link }
  // Marketing/analytics IDs (per-store GA4, Meta Pixel, TikTok Pixel)
  marketingConfig       String?  // JSON string { ga4Id, metaPixelId, tiktokPixelId }

  // ====== Platform / Monetization (CEO panel) ======
  status       String   @default("active") // active | suspended | draft
  plan         String   @default("free") // free | pro | enterprise
  platformCommissionRateBps Int @default(0) // basis points, 500 = 5%
  // Order number sequence (atomic — fixes race condition)
  orderCounter Int      @default(1000)
  invoiceCounter Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]
  categories   Category[]
  orders       Order[]
  customers    Customer[]
  members      StoreMember[]
  auditLogs    AuditLog[]
  analyticsEvents AnalyticsEvent[]
  newsletterSubscribers NewsletterSubscriber[]
  coupons      Coupon[]
  reviews      ProductReview[]
  wishlists    Wishlist[]
  abandonedCarts AbandonedCart[]
  payouts      SellerPayout[]
  blogPosts    BlogPost[]
  influencers  Influencer[]
  affiliates   Affiliate[]
}

// ====== Users (simplified — no password auth for demo) ======
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  memberships StoreMember[]
}

model StoreMember {
  id      String @id @default(cuid())
  userId  String
  storeId String
  role    String @default("owner") // owner | admin | staff
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

// ====== Catalog (scoped to Store) ======
model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String?
  subtitle    String?
  description String
  thumbnail   String?
  // Price stored in smallest currency unit (paisa for NPR) to avoid float issues
  price       Int
  compareAt   Int?
  sku         String?
  // Barcodes (Ecommerce panel) — for retail expansion + courier label printing
  gtin        String?  // Global Trade Item Number (UPC/EAN)
  barcode     String?  // Scan-to-find at packing
  status      String   @default("published") // draft | published
  inventory   Int      @default(0)
  weightGrams Int?
  // Parcel dimensions for volumetric weight (Logistics panel)
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  // Nepal-specific
  origin      String?
  isHandmade  Boolean  @default(false)
  // Rich content (Content panel) — beyond plain description
  specifications String? // JSON string { material, weight, dimensions, care }
  artisanStory String?
  careGuide   String?
  // Ops (Ecommerce panel)
  lowStockThreshold Int @default(5)
  viewCount   Int      @default(0)
  // Legal — restricted products / age gate (Legal panel)
  restrictedCategory  String?  @default("none") // none | alcohol | tobacco | cannabis | pharmaceutical | wildlife | adult | other
  ageRestricted       Boolean  @default(false)
  minAge              Int      @default(0)
  healthWarningText   String?
  requiresLicense     String?  // e.g. "DDA License #xxx" for pharmaceuticals

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     ProductReview[]
  wishlists   Wishlist[]

  @@index([storeId])
  @@index([storeId, barcode])
  @@unique([storeId, slug])
}

// Product variants — for size/color/weight options
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  title     String  // e.g. "Red / Large" or "250g"
  price     Int?    // paisa — overrides Product.price when set
  inventory Int    @default(0)
  attributes Json   // e.g. { color: "Red", size: "L" } or { weight: "250g" }
  sortOrder Int    @default(0)
  orderItems OrderItem[]

  @@index([productId])
}

// Additional product images (beyond the thumbnail)
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int    @default(0)

  @@index([productId])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  icon        String?
  description String?
  imageUrl    String?
  editorialMd String?  // Long-form SEO content for category page (Content panel)
  parentId    String?  // self-relation for hierarchy
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int      @default(0)
  products    Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

// ====== Orders (scoped to Store) ======
model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber String
  // Separate invoice number — sequential, fiscal-year scoped, immutable (Accountant panel)
  invoiceNumber       String?
  invoiceSequence     Int     @default(0)
  invoiceFiscalYearBs String? // e.g. "2081-82"

  // Extended status enum (Ops panel) — pending | processing | shipped | delivered | cancelled | returned | refunded | on_hold
  status      String   @default("pending")
  fulfillment String   @default("unfulfilled") // unfulfilled | fulfilled | returned
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // Customer snapshot (so order survives even if customer deleted)
  customerName     String
  customerPhone    String
  customerEmail    String?

  // Shipping — Nepal only. Structured address fields (Logistics panel)
  shippingAddress     String
  shippingCity        String
  shippingDistrict    String
  shippingZone        String // Province
  shippingWard        String?
  shippingMunicipality String?
  shippingPostalCode  String?

  // Payment — Nepal methods
  paymentMethod String // cod | esewa | khalti
  paymentStatus String @default("unpaid") // unpaid | pending | paid | refunded | partially_refunded

  // Money in paisa — including VAT (Accountant panel)
  subtotal     Int
  shippingCost Int
  taxRate      Int     @default(0) // basis points, 1300 = 13%
  taxTotal     Int     @default(0) // VAT amount in paisa
  taxInclusive Boolean @default(true)
  discountAmount Int   @default(0)
  total        Int

  // Customer-facing notes vs staff-only internal notes (Ops panel)
  notes           String?
  internalNotes   String?

  // Courier / tracking (Logistics panel)
  courier         String? // pathao | nepal_can_move | aramex | fedex | other
  trackingNumber  String?
  courierShipmentId String?

  // COD risk scoring (Logistics + CEO panels)
  codRiskScore       Int?
  codVerified        Boolean @default(false)
  codVerificationMethod String?
  riskScore          Int?    // 0-100 general risk
  verificationStatus String  @default("unverified") // unverified | otp_verified | deposit_paid | admin_approved | rejected

  // Dispute / refund tracking (CEO panel)
  disputeStatus    String? // none | opened | under_review | won | lost
  disputeReason    String?
  disputeOpenedAt  DateTime?

  // Marketing attribution (Marketing panel)
  utm              String? // JSON { source, medium, campaign, term, content }
  referrer         String?
  affiliateId      String?
  commissionAmount Int     @default(0)

  // Coupon (Ecommerce panel)
  couponId         String?
  coupon           Coupon? @relation(fields: [couponId], references: [id])

  // Status timestamps (Ops panel) — for SLA reporting
  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  refundedAt   DateTime?
  heldReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     OrderItem[]
  events    OrderEvent[]
  refunds   Refund[]
  returns   ReturnRequest[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, paymentStatus])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  variantTitle String? // snapshot of variant title, e.g. "Red / Large"
  thumbnail String?
  // Unit price snapshot — server-verified at checkout (never trusted from client)
  price     Int
  taxRate   Int      @default(0)
  taxAmount Int      @default(0)
  quantity  Int
}

// Order events — audit trail of every status change (Ops panel)
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // status_change | note_added | refund_issued | dispute_opened | ...
  message   String
  actorId   String?
  actorKind String   @default("system") // system | user | customer | cron
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Refunds (CEO panel) — full or partial
model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int      // paisa
  reason      String
  method      String   // original | esewa | khalti | bank_transfer | cash
  status      String   @default("pending") // pending | processed | failed
  processedAt DateTime?
  transactionRef String?
  initiatedBy String   @default("admin") // admin | customer | gateway
  notes       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// Return requests (Ops panel) — RMA workflow
model ReturnRequest {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     String
  reason      String
  reasonCode  String   // size | defective | wrong_item | changed_mind | other
  itemsRequested String? // JSON snapshot
  status      String   @default("requested") // requested | approved | rejected | received | refunded | exchanged
  refundAmount Int?
  refundMethod String?
  trackingNumber String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  district  String?
  // Privacy/compliance (Legal panel)
  consentAt            DateTime?
  consentVersion       String?
  marketingOptIn       Boolean  @default(false)
  requestedDeletionAt  DateTime?
  anonymizedAt         DateTime?
  dataExportedAt       DateTime?
  // Preferred display currency (CEO panel)
  preferredDisplayCurrency String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, phone])
  @@index([storeId])
}

// ====== New: Audit log (Data panel) ======
model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId   String?
  actorKind String   @default("anonymous") // anonymous | user | system | cron
  action    String   // order.update | product.delete | store.update | ...
  entityType String  // order | product | category | store | customer
  entityId  String
  before    String?  // JSON string
  after     String?  // JSON string
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([storeId, entityType, createdAt])
  @@index([actorId, createdAt])
}

// ====== New: Analytics events (Data panel) ======
model AnalyticsEvent {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      String   // page_view | product_view | add_to_cart | checkout_start | checkout_complete | checkout_abandon | search
  sessionId String
  userId    String?
  productId String?
  variantId String?
  cartValue Int?     // paisa snapshot at event time
  meta      String?  // JSON string
  createdAt DateTime @default(now())

  @@index([storeId, type, createdAt])
  @@index([sessionId])
}

// ====== New: Newsletter subscribers (Marketing panel) ======
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String?
  phone     String?  // More valuable than email in Nepal
  source    String   @default("footer") // footer | checkout | popup | exit_intent
  consentAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([storeId])
}

// ====== New: Coupons / discounts (Ecommerce + Influencer panels) ======
model Coupon {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code        String   // unique per store
  type        String   // percent | fixed | free_shipping
  value       Int      // percent (bps) OR fixed amount in paisa
  minSubtotal Int?
  maxRedemptions Int?
  perCustomerLimit Int?
  startsAt    DateTime?
  endsAt      DateTime?
  status      String   @default("active") // active | paused | expired
  influencerId String?
  affiliateId String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  orders      Order[]

  @@unique([storeId, code])
  @@index([storeId])
}

// ====== New: Product reviews (Ecommerce + Social panels) ======
model ProductReview {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    String?
  customerName  String
  customerPhone String?  // hashed for dedup, not displayed
  rating        Int      // 1-5
  title         String?
  body          String?
  imageUrl      String?
  status        String   @default("pending") // pending | approved | rejected
  verified      Boolean  @default(false) // verified buyer badge
  createdAt     DateTime @default(now())

  @@index([productId, status])
  @@index([storeId])
}

// ====== New: Wishlist (Ecommerce panel) ======
model Wishlist {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String?
  sessionKey String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  createdAt DateTime @default(now())

  @@unique([sessionKey, productId, variantId])
  @@index([storeId])
}

// ====== New: Abandoned cart (Marketing panel) ======
model AbandonedCart {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerPhone String?
  customerEmail String?
  cartData  String   // JSON snapshot
  cartValue Int      @default(0)
  recoveryToken String? @unique
  recoveredAt DateTime?
  firstReminderSentAt DateTime?
  secondReminderSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, recoveredAt])
}

// ====== New: Seller payouts (Accountant panel) — for platform commission settlement ======
model SellerPayout {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  periodStartBs   String
  periodEndBs     String
  grossSales      Int      @default(0)
  platformCommission Int   @default(0)
  tdsRateBps      Int      @default(0)
  tdsAmount       Int      @default(0)
  netPayable      Int      @default(0)
  status          String   @default("scheduled") // scheduled | paid | failed
  paidAt          DateTime?
  transactionRef  String?
  payoutMethod    String?  // esewa | khalti | bank
  createdAt       DateTime @default(now())

  @@index([storeId])
}

// ====== New: Blog / CMS (Content Marketing panel P0) ======
// Long-form editorial content for SEO — artisan stories, guides, brand storytelling.
model BlogPost {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  excerpt     String?
  body        String   // Markdown — rendered server-side
  coverImage  String?
  author      String?
  tags        String?  // JSON array of strings
  // SEO
  metaTitle       String?
  metaDescription String?
  // Publishing workflow
  status      String   @default("draft") // draft | published | archived
  publishedAt DateTime?
  // Editorial
  viewCount   Int      @default(0)
  readingMinutes Int   @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
  @@index([storeId, slug])
}

// ====== New: Influencer / Affiliate program (Marketing panel P0) ======
model Influencer {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  handle      String?  // @instagram_handle
  email       String?
  phone       String?
  // Their unique tracking slug — appears in URL as ?ref=affiliateSlug
  code        String   // unique per store
  // Commission structure
  commissionType   String  @default("percent") // percent | fixed
  commissionValue  Int     @default(1000) // bps if percent, paisa if fixed
  // Tracking
  clicks       Int     @default(0)
  conversions  Int     @default(0)
  revenue      Int     @default(0) // paisa attributed
  commissionEarned Int  @default(0)
  status       String  @default("active") // active | paused | paid_out
  // Payout tracking
  totalPaidOut Int     @default(0)
  createdAt    DateTime @default(now())

  @@unique([storeId, code])
  @@index([storeId])
}

model Affiliate {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  // Their unique tracking slug — same as Influencer but different model for separation
  code        String   // unique per store
  commissionRateBps Int @default(500) // 5% default
  clicks      Int     @default(0)
  conversions Int     @default(0)
  revenue     Int     @default(0)
  commissionEarned Int @default(0)
  totalPaidOut Int    @default(0)
  status      String  @default("active")
  createdAt   DateTime @default(now())

  @@unique([storeId, code])
  @@index([storeId])
}
