// Himal Commerce — multi-tenant commerce platform (Medusa-style)
// One platform, many stores. Each store has isolated products/orders/customers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== Tenant ======
model Store {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  logoUrl      String?
  // Branding
  primaryColor String   @default("#9C1A1A") // Nepal crimson default
  accentColor  String   @default("#E8B547") // Saffron default
  currency     String   @default("NPR")
  // Owner / contact
  ownerName    String
  ownerEmail   String?
  ownerPhone   String?
  // Status
  status       String   @default("active") // active | suspended | draft
  plan         String   @default("free") // free | pro | enterprise
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]
  categories   Category[]
  orders       Order[]
  customers    Customer[]
  members      StoreMember[]
}

// ====== Users (simplified — no password auth for demo) ======
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  memberships StoreMember[]
}

model StoreMember {
  id      String @id @default(cuid())
  userId  String
  storeId String
  role    String @default("owner") // owner | admin | staff
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

// ====== Catalog (scoped to Store) ======
model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  description String
  thumbnail   String?
  // Price stored in smallest currency unit (paisa for NPR) to avoid float issues
  price       Int
  compareAt   Int?
  sku         String?
  status      String   @default("published") // draft | published
  inventory   Int      @default(0)
  weightGrams Int?
  // Nepal-specific
  origin      String?
  isHandmade  Boolean  @default(false)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([storeId])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  icon      String?
  products  Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

// ====== Orders (scoped to Store) ======
model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber String
  status      String   @default("pending") // pending | processing | shipped | delivered | cancelled
  fulfillment String   @default("unfulfilled") // unfulfilled | fulfilled | returned
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // Customer snapshot (so order survives even if customer deleted)
  customerName     String
  customerPhone    String
  customerEmail    String?

  // Shipping — Nepal only
  shippingAddress  String
  shippingCity     String
  shippingDistrict String
  shippingZone     String // Province

  // Payment — Nepal methods
  paymentMethod String // cod | esewa | khalti
  paymentStatus String @default("unpaid") // unpaid | paid | refunded

  // Money in paisa
  subtotal     Int
  shippingCost Int
  total        Int

  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     OrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  title     String
  thumbnail String?
  price     Int
  quantity  Int
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  district  String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, phone])
  @@index([storeId])
}
